# Production Backend & Streamlit Workstation Endpoints
# In local development:
VITE_API_URL=http://127.0.0.1:8000
VITE_STREAMLIT_URL=http://localhost:8501

# In production (e.g. deployed on Vercel):
# Set VITE_API_URL to your deployed FastAPI backend (e.g., https://datapilot-api.onrender.com)
# Set VITE_STREAMLIT_URL to your deployed Streamlit app (e.g., https://datapilot.streamlit.app)
